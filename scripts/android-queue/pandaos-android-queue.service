[Unit]
Description=Bounded FIFO Android tooling broker
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/etc/pandaos-android-queue/service.env
ExecStart=/usr/bin/python3 /usr/local/lib/pandaos-android-queue/android_queue.py serve
ExecStopPost=/usr/bin/python3 /usr/local/lib/pandaos-android-queue/android_queue.py cleanup
RuntimeDirectory=pandaos-android-queue
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
TimeoutStartSec=25
KillMode=control-group
UMask=0077
MemoryMax=256M
MemorySwapMax=0
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=multi-user.target
